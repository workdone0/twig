---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Twig — Terminal JSON & YAML Explorer">
    <section class="hero">
        <p class="eyebrow">v3.0.0 · Rust rewrite</p>
        <h1 class="hero-title">
            A terminal-first<br />
            <span class="accent">JSON &amp; YAML</span> explorer
        </h1>
        <p class="tagline">
            Understand complex data locally — fast, private, and
            SSH-friendly.
        </p>

        <div class="install">
            <div class="install-row">
                <code class="install-cmd"
                    ><span class="prompt">$</span> curl -fsSL
                    https://twig.wtf/install.sh | sh</code
                >
                <button class="copy-btn" id="hero-copy" aria-label="Copy install command">
                    Copy
                </button>
            </div>
            <p class="install-hint">
                Single static binary · Linux · macOS · Windows · MIT
            </p>
        </div>

        <div class="hero-cta">
            <a
                href="https://github.com/workdone0/twig"
                class="btn btn-primary"
                rel="noopener"
                >View on GitHub</a
            >
            <a href="/guide" class="btn btn-secondary">Read the docs</a>
        </div>
    </section>

    <section class="demo">
        <div class="terminal" role="img" aria-label="Twig TUI demo">
            <div class="terminal-bar">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
                <span class="terminal-title">twig — cloud_infrastructure.json</span>
            </div>
            <img
                src="https://raw.githubusercontent.com/workdone0/twig/master/asset/demo.gif"
                alt="Twig TUI demonstrating Miller-column navigation of a JSON file"
                loading="lazy"
                width="1200"
                height="640"
            />
        </div>
        <p class="demo-caption">
            Miller-column navigation · smart inspector · keyboard-driven
        </p>
    </section>

    <section class="features">
        <div class="features-grid">
            <article class="feature">
                <div class="feature-icon" aria-hidden="true">📂</div>
                <h3>Multi-format native</h3>
                <p>
                    JSON and YAML with the same UI. Format is
                    auto-detected from the file extension.
                </p>
            </article>

            <article class="feature">
                <div class="feature-icon" aria-hidden="true">⚡</div>
                <h3>Streaming ingestion</h3>
                <p>
                    Constant memory regardless of file size. A 50 MB
                    JSON loads in ~16 ms — about 3 GB/s.
                </p>
            </article>

            <article class="feature">
                <div class="feature-icon" aria-hidden="true">🔍</div>
                <h3>Deep search</h3>
                <p>
                    Substring search across keys and values. Press
                    <kbd>/</kbd>, jump matches with <kbd>n</kbd> /
                    <kbd>N</kbd>.
                </p>
            </article>

            <article class="feature">
                <div class="feature-icon" aria-hidden="true">🧭</div>
                <h3>Miller columns</h3>
                <p>
                    Traverse deep trees with the keyboard. Breadcrumbs
                    keep you oriented, the inspector shows you what
                    matters.
                </p>
            </article>

            <article class="feature">
                <div class="feature-icon" aria-hidden="true">🔒</div>
                <h3>Secure by design</h3>
                <p>
                    100% local and read-only. No network calls, no
                    telemetry. Safe for production secrets.
                </p>
            </article>

            <article class="feature">
                <div class="feature-icon" aria-hidden="true">🦀</div>
                <h3>Single Rust binary</h3>
                <p>
                    ~4 MB statically linked. Drop it on any Linux,
                    macOS, or Windows machine and it runs.
                </p>
            </article>
        </div>
    </section>

    <section class="quickstart">
        <div class="quickstart-inner">
            <header class="section-header">
                <p class="eyebrow">Quickstart</p>
                <h2>Up and running in three commands.</h2>
                <p class="section-lead">
                    Install Twig, open a file, and you're navigating with
                    the keyboard in under a minute.
                </p>
            </header>

            <ol class="steps">
                <li class="step-card">
                    <div class="step-marker">
                        <span class="step-num">01</span>
                    </div>
                    <div class="step-body">
                        <p class="step-eyebrow">Step 1</p>
                        <h3 class="step-title">Install the binary</h3>
                        <p class="step-desc">
                            Downloads the prebuilt release for your
                            platform, verifies its SHA-256, and drops
                            <code>twig</code> into your path.
                        </p>
                        <pre><code>curl -fsSL https://twig.wtf/install.sh | sh</code></pre>
                    </div>
                </li>

                <li class="step-card">
                    <div class="step-marker">
                        <span class="step-num">02</span>
                    </div>
                    <div class="step-body">
                        <p class="step-eyebrow">Step 2</p>
                        <h3 class="step-title">Open a file</h3>
                        <p class="step-desc">
                            Format auto-detected from the extension. No
                            flags, no config — just point Twig at a
                            file.
                        </p>
                        <pre><code>twig data.json</code></pre>
                    </div>
                </li>

                <li class="step-card">
                    <div class="step-marker">
                        <span class="step-num">03</span>
                    </div>
                    <div class="step-body">
                        <p class="step-eyebrow">Step 3</p>
                        <h3 class="step-title">Navigate with the keyboard</h3>
                        <p class="step-desc">
                            The mouse never has to leave the desk.
                            Everything Twig does is a keystroke away.
                        </p>
                        <pre><code>↑ ↓ ← →    move
/          search
:          jump to path
c          copy path
q          quit</code></pre>
                    </div>
                </li>
            </ol>
        </div>
    </section>

    <section class="why">
        <div class="why-inner">
            <header class="section-header">
                <p class="eyebrow">Why Twig</p>
                <h2>Built for the terminal.</h2>
                <p class="section-lead">
                    A focused tool for a specific job. Twig does one
                    thing — interactive JSON and YAML exploration — and
                    does it without making you learn a new DSL, paste
                    production data into a browser, or install a heavy
                    IDE plugin.
                </p>
            </header>

            <div class="why-grid">
                <article class="why-card">
                    <p class="why-label">Versus</p>
                    <h3 class="why-tool">
                        <code>jq</code>
                    </h3>
                    <p class="why-text">
                        <code>jq</code> is the right tool for
                        <em>transforming</em> JSON. Twig is the right tool
                        for <em>exploring</em> it — no syntax to learn,
                        no expressions to write, no pipeline to design.
                        Just point and look.
                    </p>
                </article>

                <article class="why-card">
                    <p class="why-label">Versus</p>
                    <h3 class="why-tool">Web viewers</h3>
                    <p class="why-text">
                        Pasting production data — API responses, K8s
                        manifests, log exports — into a browser is a
                        security risk. Twig runs entirely on your
                        machine. Works over SSH, on air-gapped boxes,
                        on shared servers.
                    </p>
                </article>

                <article class="why-card">
                    <p class="why-label">Versus</p>
                    <h3 class="why-tool">IDE plugins</h3>
                    <p class="why-text">
                        IDE JSON tools are heavy and GUI-only. Twig is a
                        single ~4 MB binary that runs anywhere a
                        terminal does — including inside your editor's
                        integrated terminal, over SSH, on a fresh
                        container.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <section class="final-cta">
        <h2>Ready to explore?</h2>
        <div class="install">
            <div class="install-row">
                <code class="install-cmd"
                    ><span class="prompt">$</span> curl -fsSL
                    https://twig.wtf/install.sh | sh</code
                >
                <button class="copy-btn" id="footer-copy" aria-label="Copy install command">
                    Copy
                </button>
            </div>
        </div>
        <p class="install-hint">
            No Python, no runtime, no dependencies. Just one binary.
        </p>
    </section>
</Layout>

<script>
    function setupCopy(id, text) {
        const btn = document.getElementById(id);
        if (!btn) return;
        btn.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(text);
            } catch (_) {
                // Fallback for non-clipboard-API environments
                const ta = document.createElement("textarea");
                ta.value = text;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand("copy");
                ta.remove();
            }
            const orig = btn.textContent;
            btn.textContent = "Copied!";
            btn.classList.add("copied");
            setTimeout(() => {
                btn.textContent = orig;
                btn.classList.remove("copied");
            }, 1500);
        });
    }
    setupCopy(
        "hero-copy",
        "curl -fsSL https://twig.wtf/install.sh | sh",
    );
    setupCopy(
        "footer-copy",
        "curl -fsSL https://twig.wtf/install.sh | sh",
    );
</script>

<style>
    /* Hero */
    .hero {
        text-align: center;
        padding: 3rem 0 2.5rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .eyebrow {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--accent-color);
        background: var(--accent-glow);
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        border: 1px solid color-mix(in oklab, var(--accent-color) 30%, transparent);
        margin-bottom: 1.5rem;
    }

    .hero-title {
        font-size: var(--fs-hero);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.04em;
        margin-bottom: 1rem;
    }

    .accent {
        color: var(--accent-color);
        position: relative;
        display: inline-block;
    }

    .accent::after {
        content: "";
        position: absolute;
        bottom: 4px;
        left: 0;
        width: 100%;
        height: 18%;
        background: var(--accent-color);
        opacity: 0.18;
        z-index: -1;
        border-radius: 4px;
    }

    .tagline {
        font-size: 1.05rem;
        color: var(--text-secondary);
        max-width: 520px;
        margin: 0 auto 2rem;
        line-height: 1.55;
    }

    @media (min-width: 768px) {
        .tagline {
            font-size: 1.2rem;
        }
    }

    /* Install command block */
    .install {
        margin: 0 auto 2rem;
        max-width: 100%;
    }

    .install-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        padding: 0.625rem 0.75rem 0.625rem 1rem;
        border-radius: 12px;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
        max-width: 580px;
        margin: 0 auto;
    }

    @media (min-width: 768px) {
        .install-row {
            padding: 0.75rem 1rem 0.75rem 1.25rem;
            font-size: 0.95rem;
        }
    }

    .install-cmd {
        flex: 1;
        font-family: inherit;
        background: transparent;
        border: 0;
        padding: 0;
        font-size: inherit;
        color: var(--text-primary);
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: normal;
    }

    .install-cmd .prompt {
        color: var(--accent-color);
        margin-right: 0.5rem;
        user-select: none;
    }

    .copy-btn {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        color: var(--text-secondary);
        cursor: pointer;
        padding: 0.35rem 0.75rem;
        font-size: 0.75rem;
        border-radius: 6px;
        transition: all 0.15s;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        font-family: var(--font-body);
        flex-shrink: 0;
    }

    .copy-btn:hover {
        color: var(--text-primary);
        background: var(--bg-primary);
    }

    .copy-btn.copied {
        background: var(--accent-color);
        color: var(--bg-primary);
        border-color: var(--accent-color);
    }

    .install-hint {
        margin-top: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        margin-top: 1rem;
    }

    /* Demo */
    .demo {
        max-width: 960px;
        margin: 0 auto var(--space-section);
        position: relative;
    }

    .demo::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 80%;
        height: 80%;
        background: var(--accent-color);
        opacity: 0.04;
        filter: blur(120px);
        z-index: -1;
    }

    .terminal {
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        background: #1e1e2e;
        box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.45);
    }

    .terminal-bar {
        background: #181825;
        padding: 0.625rem 0.875rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        border-bottom: 1px solid #313244;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .dot.red {
        background: #f38ba8;
    }
    .dot.yellow {
        background: #f9e2af;
    }
    .dot.green {
        background: #a6e3a1;
    }

    .terminal-title {
        margin-left: auto;
        color: #a6adc8;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        opacity: 0.7;
    }

    .terminal img {
        display: block;
        width: 100%;
        height: auto;
    }

    .demo-caption {
        margin-top: 1rem;
        font-size: var(--fs-small);
        color: var(--text-muted);
        text-align: center;
    }

    /* Features grid */
    .features {
        max-width: var(--max-width);
        margin: 0 auto;
    }

    .features-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    @media (min-width: 640px) {
        .features-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.25rem;
        }
    }

    @media (min-width: 960px) {
        .features-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .feature {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.5rem;
        transition: border-color 0.2s, transform 0.2s;
    }

    .feature:hover {
        border-color: var(--border-focus);
        transform: translateY(-2px);
    }

    .feature-icon {
        width: 40px;
        height: 40px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        margin-bottom: 1rem;
    }

    .feature h3 {
        margin-bottom: 0.5rem;
    }

    .feature p {
        font-size: var(--fs-small);
        margin: 0;
    }

    .feature kbd {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-bottom-width: 2px;
        border-radius: 4px;
        padding: 0 0.3rem;
        color: var(--text-primary);
    }

    /* Quickstart */
    .quickstart {
        padding: 4rem 0;
    }

    .quickstart-inner {
        max-width: 880px;
        margin: 0 auto;
    }

    .section-header {
        text-align: center;
        max-width: 640px;
        margin: 0 auto 3rem;
    }

    .section-header h2 {
        font-size: clamp(1.75rem, 3vw + 0.75rem, 2.25rem);
        margin-bottom: 0.75rem;
    }

    .section-lead {
        font-size: 1.05rem;
        color: var(--text-secondary);
        line-height: 1.6;
    }

    .steps {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        position: relative;
    }

    /* Vertical timeline rail connecting the three steps */
    .steps::before {
        content: "";
        position: absolute;
        top: 28px;
        bottom: 28px;
        left: 27px;
        width: 2px;
        background: linear-gradient(
            to bottom,
            var(--border-color),
            transparent 90%
        );
    }

    .step-card {
        display: grid;
        grid-template-columns: 56px 1fr;
        gap: 1.25rem;
        align-items: start;
        position: relative;
    }

    .step-marker {
        width: 56px;
        height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        position: relative;
        z-index: 1;
    }

    .step-marker::before {
        content: "";
        position: absolute;
        inset: 4px;
        border-radius: 12px;
        background: var(--accent-glow);
        z-index: -1;
    }

    .step-num {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--accent-color);
        letter-spacing: 0.05em;
    }

    .step-body {
        padding-top: 0.5rem;
        min-width: 0;
    }

    .step-eyebrow {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
    }

    .step-card h3.step-title {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
    }

    .step-desc {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1rem;
        max-width: 56ch;
    }

    .step-card pre {
        margin: 0;
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 0.875rem 1rem;
        font-size: 0.85rem;
        line-height: 1.6;
    }

    /* Why */
    .why {
        /* The Why section gets visual separation from the sections
           above (Features) and below (Final CTA) via generous top
           AND bottom padding, not border lines. Borders on the band
           combined with borders on each card looked like a single
           thick bar where the section's edge met the card edges --
           two competing lines on the same visual axis. Dropping the
           outer borders lets the cards be the only border in the
           area, which is the hierarchy we want. */
        padding: 6rem 0 7rem;
    }

    .why-inner {
        max-width: var(--max-width);
        margin: 0 auto;
    }

    .why-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.75rem;
    }

    @media (min-width: 768px) {
        .why-grid {
            grid-template-columns: repeat(3, 1fr);
            /* Card gap needs to clearly exceed the card's own
               internal horizontal padding so adjacent cards read
               as separate tiles, not as one wide card split by a
               vertical line. */
            gap: 2.5rem;
        }
    }

    .why-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        /* Larger radius + slightly stronger border at rest so the
           card body reads as a single tile, not a content block with
           a 1px hairline around it. */
        border-radius: 16px;
        padding: 2.25rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
        transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .why-card:hover {
        border-color: var(--border-focus);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.18);
    }

    .why-label {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        margin: 0;
    }

    .why-card .why-tool {
        font-size: 1.35rem;
        margin: 0;
        color: var(--text-primary);
        font-weight: 600;
    }

    .why-card .why-tool code {
        font-size: 1em;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        color: var(--accent-color);
        padding: 0.1em 0.4em;
        border-radius: 6px;
    }

    .why-text {
        font-size: 0.95rem;
        line-height: 1.65;
        color: var(--text-secondary);
        margin: 0;
    }

    .why-text code {
        font-size: 0.875em;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        padding: 0.1em 0.35em;
        border-radius: 4px;
    }

    .why-text em {
        color: var(--accent-color);
        font-style: italic;
    }

    /* Final CTA */
    .final-cta {
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
    }

    .final-cta h2 {
        margin-bottom: 1.5rem;
    }
</style>
